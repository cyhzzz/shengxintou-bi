# 省心投 BI - 环境变量配置示例
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写实际配置值
# 3. .env 文件不会提交到Git（已在.gitignore中）
# 4. 不要将 .env 文件分享给他人

# ============================================================================
# 数据库配置
# ============================================================================

# 数据库文件路径（相对于项目根目录）。
# 本地 SQLite 模式下使用；若配置了 DATABASE_URL 则优先生效。
DATABASE_PATH=database/shengxintou.db

# 数据库类型（sqlite / postgresql）
# 注意：当前仅支持 SQLite 与 Postgres。
# 留空时由 DATABASE_URL 是否设置自动推断，无需手填
DATABASE_TYPE=

# ============================================================================
# 云端数据库（feat-cloud-supabase）
# ============================================================================
# 当设了 DATABASE_URL，SQLAlchemy 走 postgresql+psycopg；否则走 DATABASE_PATH（SQLite）。
# 切换后启动期会调用 db.create_all()，9 张业务表自动建好；中文列名保持不变。

# 标准 PostgreSQL DSN，例：
#   postgresql+psycopg://postgres:<password>@<host>:<port>/<dbname>
# 注：<password> 含 @ / : / ? 等字符需 URL-encode
DATABASE_URL=

# Supabase Project Settings → API：
#   Project URL（仅 URL，不含 key）
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon key（前端可在浏览器暴露的公开 API key）
# 留空或填占位值，启动期会打 ERROR 并不阻塞启动
SUPABASE_ANON_KEY=sb_publishable_or_anon_xxx_placeholder

# Supabase service_role key（**后端最高权限 key，绝不能给前端 / 浏览器 / commit**）
# 仅在 server 端使用，例如读取 user_profiles、调 admin API。
# .env 必须在 .gitignore；轮换时直接覆盖此行即可。
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here_never_commit

# 可选：是否启用鉴权中间件（true=全部 /api/v1/* 必须登录；false=关闭鉴权退回旧行为）
# 开发版（Web）默认 false；桌面版（Electron）默认 true
AUTH_ENABLED=false

# ============================================================================
# 服务器配置
# ============================================================================

# 服务器监听地址
HOST=127.0.0.1

# 服务器监听端口
PORT=5000

# 调试模式（true/false）
DEBUG=false

# 开发模式（true=浏览器模式，false或未设置=pywebview模式）
DEV_MODE=true

# ============================================================================
# 飞书集成配置
# ============================================================================

# 飞书应用ID
FEISHU_APP_ID=cli_xxxxxxxxxx

# 飞书应用密钥
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 飞书机器人Webhook地址（可选）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxx

# ============================================================================
# WebDAV配置
# ============================================================================

# WebDAV服务器地址
WEBDAV_URL=https://dav.example.com

# WebDAV用户名
WEBDAV_USERNAME=username

# WebDAV密码
WEBDAV_PASSWORD=your_webdav_password_here

# WebDAV基础路径（备份目录）
WEBDAV_BASE_PATH=/shengxintou-backup/
# 或使用旧名称（向后兼容）
# WEBDAV_BACKUP_DIR=/shengxintou-backup/

# ============================================================================
# 文件上传配置
# ============================================================================

# 上传文件大小限制（单位：MB）
MAX_CONTENT_LENGTH=100

# 允许的文件类型（逗号分隔）
ALLOWED_EXTENSIONS=xlsx,xls,csv

# 上传文件保存路径
UPLOAD_FOLDER=uploads

# ============================================================================
# 日志配置
# ============================================================================

# 日志级别（DEBUG/INFO/WARNING/ERROR/CRITICAL）
LOG_LEVEL=INFO

# 日志文件路径
LOG_FOLDER=logs

# 日志文件保留天数
LOG_RETENTION_DAYS=30

# ============================================================================
# 数据刷新配置
# ============================================================================

# 数据刷新时间间隔（单位：秒）
DATA_REFRESH_INTERVAL=300

# 缓存过期时间（单位：秒）
CACHE_EXPIRE_TIME=600

# ============================================================================
# 其他配置
# ============================================================================

# 时区设置
TIMEZONE=Asia/Shanghai

# 语言设置
LANGUAGE=zh_CN

# 密钥加密盐值（用于加密敏感信息）
SECRET_KEY=your_secret_key_here_change_it_in_production

# ============================================================================
# 开发提示
# ============================================================================

# 生产环境请务必修改所有密钥和密码
# 不要将 .env 文件提交到版本控制系统
# 定期更换密钥以保证系统安全
