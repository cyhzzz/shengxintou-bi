# ========================================
# 省心投 BI - Git 忽略配置
# ========================================
# 说明: 本仓库只管理开发代码，不包含打包输出、日志等

# ===== 敏感配置文件 =====
.env
.env.local
.env.*.local

# ===== 数据库文件 =====
*.db
*.sqlite
*.sqlite3
database/*.db

# ===== 日志文件 =====
logs/
*.log

# ===== 用户上传文件 =====
uploads/

# ===== 临时文件 =====
tmp/
temp/
*.tmp
tmpclaude-*/

# ===== Python 产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# ===== 虚拟环境 =====
venv/
ENV/
env/
.venv

# ===== 打包产物 =====
*.exe
*.dll
*.dylib
# 启动器(省心投启动器.exe)作为发布物纳入版本管理；其余 exe 仍忽略
!省心投启动器.exe
../版本输出/

# ===== 便携版依赖（本地开发不需要）=====
lib/
lib.zip
python-3.9-embed/

# ===== IDE 配置 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 备份文件 =====
*.bak
*.backup
*~

# ===== 测试和覆盖率 =====
.pytest_cache/
.coverage
htmlcov/

# ===== 根目录的其他目录（不包含在开发代码中）=====
../../版本输出/
../../temp/
../../开发日志/
../../构建脚本/
../../.claude/

# data source xlsx (not in repo)
数据源/
# workbuddy memory
.workbuddy/
# playwright cli cache
.playwright-cli/
# transient webdav tmp
database/tmp_*.db.gz

# transient scripts

tmp_*.py

tmp_*.cjs

tmp_*.ps1

.tmp_*.py

# prototype artifacts

prototype/

# UI compare shots

logs/bug-fix-shots/

frontend-react/logs/

frontend-react/_compare_shots.cjs

frontend-react/tmp_*.cjs

# node_modules at root (accidental)
node_modules/
