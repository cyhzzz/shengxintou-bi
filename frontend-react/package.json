{
  "name": "shengxintou-platform",
  "private": true,
  "version": "0.9.4",
  "type": "module",
  "scripts": {
    "setup": "node ../scripts/setup.mjs",
    "setup:win": "..\\scripts\\setup.bat",
    "setup:unix": "bash ../scripts/setup.sh",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test --config playwright.config.ts",
    "test:smoke": "playwright test tests/smoke",
    "test:functional": "playwright test --config tests/functional/playwright.functional.config.ts",
    "test:regression": "playwright test tests/regression",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "generate:api": "orval --config orval.config.ts",
    "generate:api:watch": "orval --config orval.config.ts --watch",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.1.0",
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/preferences": "^7.0.4",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "antd": "^6.3.2",
    "dayjs": "^1.11.19",
    "echarts": "^6.0.0",
    "framer-motion": "^12.42.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "rollup": "^4.62.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.4.0",
    "orval": "^7.3.0",
    "sass": "^1.98.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
